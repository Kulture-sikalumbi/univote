{
  "name": "univote",
  "private": true,
  "version": "0.1.0",
  "description": "UniVote — multi-tenant secure digital student election platform",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/api && npm run build --workspace=apps/web",
    "test:unit": "npm run test:unit --workspace=apps/api",
    "test:integration": "npm run test:integration --workspace=apps/api",
    "test:e2e": "npm run test:e2e --workspace=apps/api",
    "seed:e2e": "npm run seed:e2e --workspace=apps/api",
    "prisma:generate": "npm run prisma:generate --workspace=apps/api"
  }
}
